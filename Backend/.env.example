# Server Port
PORT=3000

# Admin Portal Security Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=rudraksha@admin2026
ADMIN_SECRET_KEY=rudraksha_enterprise_secret_2026

# Supabase Configuration (Free Tier - https://supabase.com)
# Leave empty to run in offline local JSON fallback mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The backend requires the service-role key; never expose it in frontend code.

# Telegram Bot Instant Notification (100% Free)
# 1. Create a bot using @BotFather on Telegram to get your BOT_TOKEN
# 2. Get your Chat ID from @userinfobot or channel ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OTP Mode: use 'production' for deployment; 'dev' is for local testing only
OTP_MODE=production

# Real SMS Gateway Configurations (Optional - Add your key to send real SMS to mobile)
# Option A: Fast2SMS (India Quick OTP API - https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Option B: 2Factor.in (India SMS API - https://2factor.in)
TWO_FACTOR_API_KEY=

# Option C: Twilio (Global SMS API - https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

